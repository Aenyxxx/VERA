# Copy to apps/api/.env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:5173

# Supabase → Project Settings → Database → Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_SSL=true

# Supabase → Project Settings → API (server-only secret key; never put it in the web app)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Python microservice (must match apps/svc/.env)
SVC_URL=http://127.0.0.1:8000
SVC_INTERNAL_KEY=

# Email (Gmail: create an App Password with 2-step verification on)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Confiable Manpower (VERA) <your-address@gmail.com>"

# Scheduled jobs (deadline expiry, reminders, email outbox)
JOBS_ENABLED=true

# Used only by: pnpm --filter api seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
