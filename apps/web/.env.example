# Copy to apps/web/.env. Only VITE_* values reach the browser — never put secrets here.
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase → Project Settings → API → publishable (anon) key. Safe for the browser because RLS blocks all table access.
VITE_SUPABASE_PUBLISHABLE_KEY=
