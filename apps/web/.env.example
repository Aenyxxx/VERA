# Copy to apps/web/.env. Only VITE_* values reach the browser — never put secrets here.
# Relative: the Vite dev server proxies /api to the API on :5000 (vite.config.js), so a dev tunnel needs only 5173.
VITE_API_URL=/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase → Project Settings → API → publishable (anon) key. Safe for the browser because RLS blocks all table access.
VITE_SUPABASE_PUBLISHABLE_KEY=
